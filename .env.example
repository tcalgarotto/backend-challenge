PORT=3037
HOST=127.0.0.1
# Runtime LOGIN granted jwp_runtime; migrations run separately as schema owner.
JWP_DATABASE_URL=postgresql://jwp_api:jwp_api_local@127.0.0.1:55432/jwp
JWP_MIGRATION_DATABASE_URL=postgresql://jwp:jwp_local@127.0.0.1:55432/jwp
# Full service: bun run build && bun run start:workers (HTTP + internal workers).
# bun run start defaults to HTTP only; APP_ROLES=workers runs internal workers only.
APP_ROLES=http
AWS_REGION=us-east-1
# LocalStack only; use AWS's credential chain and omit endpoint in AWS.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
JWP_SQS_ENDPOINT=http://127.0.0.1:54566
JWP_SQS_COMMAND_QUEUE_URL=http://127.0.0.1:54566/queue/us-east-1/000000000000/wager-transactions.fifo
JWP_SQS_EVENT_QUEUE_URL=http://127.0.0.1:54566/queue/us-east-1/000000000000/wager-events.fifo
# Optional additional queues (e.g. DLQs) for readiness/metrics, comma-separated.
JWP_SQS_QUEUE_URLS=
JWP_WORKER_INTERVAL_MS=250
# Optional allowlist (subset of BRL,USD,EUR, comma-separated, exact case). Absent or empty enables all; invalid fails boot.
# JWP_ENABLED_CURRENCIES=BRL,USD,EUR
# Política de reversão: per_type (padrão; um REFUND e um ROLLBACK por referência, então REFUND+ROLLBACK da mesma BET
# devolvem o stake duas vezes) ou per_reference (uma única reversão por referência). Outro valor falha no boot. Mesmo valor em todas as réplicas.
# JWP_REVERSAL_POLICY=per_type
# Only NODE_ENV=production has an effect: boot fails with INSECURE_LOCAL_AUTH_IN_PRODUCTION while the local
# (no-op) provider identity is active, unless JWP_ALLOW_INSECURE_LOCAL_AUTH=true (controlled environments only).
# NODE_ENV=production
# JWP_ALLOW_INSECURE_LOCAL_AUTH=false
# Readiness probe timeout in ms (1-30000).
# JWP_READINESS_TIMEOUT_MS=1000
