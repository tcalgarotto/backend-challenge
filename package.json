{
  "name": "jungle-wagering-processor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "start": "bun dist/main.js",
    "start:workers": "APP_ROLES=http,workers bun dist/main.js",
    "test": "bun test tests/unit",
    "test:smoke": "bun run build && bun test tests/smoke",
    "check": "bun run typecheck && bun run test && bun run test:smoke",
    "test:sqs": "bun test tests/integration/sqs --timeout 30000",
    "db:migrate": "bun src/persistence/migrate.ts",
    "test:load": "bun run build && bun scripts/load/run.ts",
    "test:compose": "bun scripts/compose-smoke/run.ts",
    "test:integration": "bash scripts/reproduce/reproduce.sh"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1130.0",
    "@mikro-orm/core": "6.6.17",
    "@mikro-orm/migrations": "6.6.17",
    "@mikro-orm/postgresql": "6.6.17",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "5.9.3",
    "zod": "3.25.76"
  }
}
